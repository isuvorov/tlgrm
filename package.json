{
  "name": "tlgrm",
  "version": "0.0.2",
  "type": "module",
  "description": "Supervisor for mcp-telegram daemons — keeps the MTProto connection owner alive outside your AI client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isuvorov/tlgrm.git"
  },
  "bin": {
    "tlgrm": "lib/cli.js"
  },
  "main": "lib/api.js",
  "types": "lib/api.d.ts",
  "exports": {
    ".": {
      "types": "./lib/api.d.ts",
      "import": "./lib/api.js",
      "default": "./lib/api.js"
    },
    "./api": {
      "types": "./lib/api.d.ts",
      "import": "./lib/api.js",
      "default": "./lib/api.js"
    },
    "./cli": {
      "types": "./lib/cli.d.ts",
      "import": "./lib/cli.js",
      "default": "./lib/cli.js"
    },
    "./mcp": {
      "types": "./lib/mcp.d.ts",
      "import": "./lib/mcp.js",
      "default": "./lib/mcp.js"
    }
  },
  "files": [
    "lib",
    "assets",
    "docs",
    "!docs/__logos",
    "config.schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "npm run build && npm run types && npm run lint && npm test",
    "dev:server": "node --watch src/cli.ts serve",
    "dev": "node --import ./tests/preload.ts --test --watch 'tests/**/*.test.ts'",
    "config:schema": "node scripts/config-schema.ts",
    "version:sync": "node scripts/sync-version.ts",
    "build:icon": "node scripts/app-icon.ts",
    "serve": "node src/cli.ts serve",
    "status": "node src/cli.ts status",
    "doctor": "node src/cli.ts doctor",
    "logs": "node src/cli.ts logs",
    "mcp": "node src/cli.ts mcp",
    "cli": "node src/cli.ts",
    "link": "pnpm run build && npm link",
    "unlink": "npm unlink -g tlgrm",
    "test": "node --import ./tests/preload.ts --test 'tests/**/*.test.ts'",
    "types": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "fix": "biome check --write src tests scripts"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": true,
          "provenance": true
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "node scripts/sync-version.ts"
        }
      ],
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "pnpm-lock.yaml",
            "CHANGELOG.md",
            "src/constants.ts"
          ],
          "message": "chore(release): v${nextRelease.version}\n\n${nextRelease.notes}\n\n[skip ci]"
        }
      ]
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@overpod/mcp-telegram": "^1.41.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=23.6"
  },
  "packageManager": "pnpm@10.33.0",
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
