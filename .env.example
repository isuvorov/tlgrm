# .env template. Copy and fill in:  cp .env.example .env
#
# TELEGRAM_* variables are read by @overpod/mcp-telegram itself; this wrapper
# only passes them to the daemon and rewrites TELEGRAM_SESSION_PATH per account.
# TLGRM_* variables are our own.
#
# This file is the per-checkout layer. The same settings also live in
# ~/.config/tlgrm/config.json (JSON, with a $schema for editor completion), which
# applies to every checkout and to `tlgrm` run from anywhere — see README
# "Configuration". Order: flags > environment > this file > that file > defaults.

# --- Required --------------------------------------------------------------
# Get them at https://my.telegram.org/apps (API development tools).
#
# Needed ONLY by the owner daemon. Do not give them to the client that your AI
# client spawns: without credentials that process cannot become a working owner
# (requireCreds() exits), which is exactly the guarantee that the connection is
# owned by the daemon and not by an editor session.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Sessions --------------------------------------------------------------
# IMPORTANT: a DIRECTORY is expected here, not a file. The wrapper appends
# <account>/session to it, and keeps daemon.lock and daemon.sock alongside.
# The supervised package expects the opposite — a path to the session file — so
# an MCP client registration points at the full path, for example
# /Users/<you>/.mcp-telegram/<account>/session
TELEGRAM_SESSION_PATH=/Users/<you>/.mcp-telegram

# Two-factor password, if enabled: QR login cannot finish without it.
# TELEGRAM_2FA_PASSWORD=

# --- Network ---------------------------------------------------------------
# The default transport dials a DC on port 80. If the owner log fills up with
# ENETUNREACH, try WSS (443) or a proxy. They cannot be combined: GramJS
# does not support SSL over a proxy and silently prefers the proxy when both are
# set (telegram-client.js:90-95).
# TELEGRAM_USE_WSS=true

# MTProto or SOCKS proxy. socks_type: 4 | 5 (empty = MTProto).
# TELEGRAM_PROXY_IP=
# TELEGRAM_PROXY_PORT=
# TELEGRAM_PROXY_SECRET=
# TELEGRAM_PROXY_SOCKS_TYPE=
# TELEGRAM_PROXY_USERNAME=
# TELEGRAM_PROXY_PASSWORD=

# --- Wrapper ---------------------------------------------------------------
# Accounts that commands apply to when no account is given. Left unset, they are
# discovered from the session base: every subdirectory holding a session file.
# TLGRM_ACCOUNTS=work personal

# Where doctor looks for MCP client registrations, colon-separated.
# TLGRM_MCP_CONFIGS=/Users/<you>/.claude.json:/Users/<you>/.cursor/mcp.json

# HTTP + MCP surface. An unset token is generated per run, which invalidates
# every connected client on restart — pin it once you have clients.
# TLGRM_PORT=7717
# TLGRM_HOST=127.0.0.1
# TLGRM_TOKEN=

# Owner logs. Default: ~/.local/share/tlgrm/logs/<account>/serve.log
# TLGRM_LOG_DIR=

# Config file to read instead of ~/.config/tlgrm/config.json.
# TLGRM_CONFIG=

# --- Diagnostics and optional tool groups of the package -------------------
# none | error | warn | info | debug
# TELEGRAM_LOG_LEVEL=warn

# MCP_TELEGRAM_ENABLE_GROUP_CALLS=1
# MCP_TELEGRAM_ENABLE_QUICK_REPLIES=1
# MCP_TELEGRAM_ENABLE_STARS=1

# Forces serve mode instead of the `serve` argument. The wrapper passes the
# argument, so leave this unset: otherwise a client would also become a daemon.
# MCP_TELEGRAM_DAEMON=1
